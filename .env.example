# ==============================================================================
# PawSOS Emergency Rescue Platform — Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=production

# Database Configuration
# Supported drivers: "sqlite" (default local), "postgres" (recommended for multi-node production)
DB_DRIVER=sqlite
DB_SOURCE=pawsos.db

# For PostgreSQL in production, use:
# DB_DRIVER=postgres
# DB_SOURCE=postgres://pawsos_user:pawsos_secure_password_2026@localhost:5432/pawsos_db?sslmode=disable

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET=pawsos_production_default_jwt_secret_change_me_in_prod

# File Storage Configuration
# Local storage directory path for animal photos
STORAGE_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# CORS Policy
# Specify allowed origin (e.g. https://pawsos.org) or "*" for open access
CORS_ALLOWED_ORIGIN=*
