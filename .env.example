# PawSOS environment variable template. Add deployment secrets through the host's
# secret manager; never put real credentials in this file.
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
DB_DRIVER=sqlite
DB_SOURCE=pawsos.db
POSTGRES_USER=pawsos
POSTGRES_DB=pawsos_db
POSTGRES_PASSWORD=
JWT_SECRET=
STORAGE_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
CORS_ALLOWED_ORIGIN=http://localhost:8080
ADMIN_EMAIL=
ADMIN_PASSWORD=
